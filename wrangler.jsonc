{
  // Cloudflare Worker config, used by `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the name of your Worker in the Cloudflare dashboard.
  "name": "reunivo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other path is served straight from public/.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets are NOT stored here. Set SILENTFORMS_TOKEN in the dashboard:
  // Workers & Pages → reunivo → Settings → Variables and Secrets.
}
